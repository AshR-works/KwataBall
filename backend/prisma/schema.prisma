generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EDITOR
  USER
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
}

model Team {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(150)
  shortName   String   @db.VarChar(10)
  city        String?  @db.VarChar(100)
  foundedYear Int?
  logoUrl     String?  @db.VarChar(255)
  externalId  String?  @unique @db.VarChar(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  players     Player[]

  homeMatches Match[] @relation("HomeMatches")
  awayMatches Match[] @relation("AwayMatches")
}

enum Position {
  POINT_GUARD
  SHOOTING_GUARD
  SMALL_FORWARD
  POWER_FORWARD
  CENTER
}

model Player {
  id           String   @id @default(uuid())
  firstName    String   @db.VarChar(100)
  lastName     String   @db.VarChar(100)
  position     Position
  jerseyNumber Int
  nationality  String   @db.VarChar(100)
  dateOfBirth  DateTime
  height       Int?
  weight       Int?
  photoUrl     String?  @db.VarChar(255)
  isActive     Boolean  @default(true)
  externalId   String?  @unique @db.VarChar(100)
  teamId       String
  team         Team     @relation(fields: [teamId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([firstName, lastName, dateOfBirth, teamId], name: "uniquePlayerIdentity")
}

enum MatchStatus {
  A_VENIR
  TERMINE
  REPORTE
  ANNULE
}

model Match {
  id              String      @id @default(uuid())
  competitionName String?     @db.VarChar(150)
  homeTeamId      String
  awayTeamId      String
  scheduledAt     DateTime
  venue           String?     @db.VarChar(150)
  status          MatchStatus @default(A_VENIR)
  homeScore       Int?
  awayScore       Int?
  externalId      String?     @unique @db.VarChar(100)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  homeTeam Team @relation("HomeMatches", fields: [homeTeamId], references: [id])
  awayTeam Team @relation("AwayMatches", fields: [awayTeamId], references: [id])
}